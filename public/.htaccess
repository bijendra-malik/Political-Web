# ============================================
# Hostinger / Apache - Next.js Static Export
# ============================================

# Enable rewrite engine
RewriteEngine On
RewriteBase /

# Use the directory-based routes generated by Next.js static export.
RewriteRule ^(about|social-work|media|contact|vision-mission|political-journey|watch-intro)$ /$1/ [R=301,L]

# Handle sub-routes: /about/ -> /about/index.html
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# If not a file or directory, serve index.html (SPA fallback)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.html [L,QSA]

# Allow access to all static files
<FilesMatch "\.(html|htm|css|js|json|png|jpg|jpeg|gif|svg|ico|mp4|webp|woff|woff2|ttf|eot|txt|xml)$">
    Require all granted
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# Error document
ErrorDocument 404 /index.html
